# Copy to `.env` and uncomment or set values as needed.
# This repo reads these keys from project-root `.env` only (not from the shell environment).
# Safe to commit; do not put real secrets here.

# --- Anthropic (classifier / preview scripts that call the API) ---
#ANTHROPIC_API_KEY=

# --- main.py defaults (override CLI flags if you add custom poe tasks) ---
# Max messages to fetch per run when --limit is omitted (default: 50).
#MESSAGE_FETCH_LIMIT=50

# Minutes of history when --lookback is omitted (default: 60).
#LOOKBACK_MINUTES=60

# Path to Messages SQLite DB (default: ~/Library/Messages/chat.db).
#CHAT_DB_PATH=/Users/you/Library/Messages/chat.db

# Text sent for STOP replies (default: STOP).
#STOP_REPLY_TEXT=STOP

# Log file path relative to repo cwd unless absolute (default: sms_agent.log).
#LOG_FILE=sms_agent.log

# Parallel Anthropic calls in main.py (default: 8, max 32). Lower if you hit rate limits.
#CLASSIFY_MAX_WORKERS=8

# Note: DRY_RUN and QUIET are controlled by CLI flags (--dry-run, --quiet), not .env.
